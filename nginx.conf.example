# Inside the server { } block that serves the reader. Assumes the reader is at /reader/; the TTS paths are
# on the site root, wherever the reader lives. breeze-host is the machine running docker-compose.yml.
# Create the password file with:  htpasswd -c /etc/nginx/reader.htpasswd yourname

location /reader/ {
    auth_basic "Reader";
    auth_basic_user_file /etc/nginx/reader.htpasswd;
    types { application/wasm wasm; }   # for the self-hosted natural voices
}

# The Breeze TTS API.
location /tts/ {
    auth_basic "Reader";
    auth_basic_user_file /etc/nginx/reader.htpasswd;
    proxy_pass http://breeze-host:7860/;   # trailing slash: /tts/health -> /health
    proxy_http_version 1.1;
    proxy_buffering off;                   # audio streams back while it is generated
    proxy_request_buffering off;
    proxy_read_timeout 300s;
    client_max_body_size 20m;              # each request uploads the voice's reference clip
}

# The voices the reader offers (voices.json and the reference clips), served by the studio.
location /tts-voices/ {
    auth_basic "Reader";
    auth_basic_user_file /etc/nginx/reader.htpasswd;
    proxy_pass http://breeze-host:7861/voices/;
}

# The voice studio. Use HTTPS: browsers only allow microphone recording on secure pages.
location /tts-studio/ {
    auth_basic "Reader";
    auth_basic_user_file /etc/nginx/reader.htpasswd;
    proxy_pass http://breeze-host:7861/;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_buffering off;                   # the studio streams progress and results
    proxy_read_timeout 600s;
    client_max_body_size 50m;              # uploaded recordings
}
