# Inside the server { } block that serves the reader. Assumes the reader is at /reader/ (index.html and
# tts-voices/ next to it). The voice API must be at /tts/ on the site root, wherever the reader lives.

# Ask for a password for the reader and its voice server, so others can't use your GPU.
# Create the file with:  htpasswd -c /etc/nginx/reader.htpasswd yourname
location /reader/ {
    auth_basic "Reader";
    auth_basic_user_file /etc/nginx/reader.htpasswd;
    types { application/wasm wasm; }   # for the self-hosted natural voices
}

location /tts/ {
    auth_basic "Reader";
    auth_basic_user_file /etc/nginx/reader.htpasswd;
    proxy_pass http://breeze-host:7860/;   # your Breeze server; trailing slash: /tts/health -> /health
    proxy_http_version 1.1;
    proxy_buffering off;                 # audio streams back while it is generated
    proxy_request_buffering off;
    proxy_read_timeout 300s;
    client_max_body_size 20m;            # each request uploads the voice's reference clip
}
