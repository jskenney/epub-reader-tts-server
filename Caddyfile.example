# Reader at https://example.com/reader/ with the voice API at /tts/ on the site root.
example.com {
	# Ask for a password for the reader and its voice server, so others can't use your GPU.
	# Make the hash with:  caddy hash-password
	basic_auth /reader/* {
		yourname $2a$14$REPLACE_WITH_THE_HASH
	}
	basic_auth /tts/* {
		yourname $2a$14$REPLACE_WITH_THE_HASH
	}

	handle_path /tts/* {
		reverse_proxy breeze-host:7860 {   # your Breeze server
			flush_interval -1   # stream audio as it is generated
		}
	}

	handle /reader/* {
		root * /srv/www
		file_server
	}
}
