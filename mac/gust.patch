+
+# --- epub-reader-tts-server: no instruction, as upstream Breeze --------------------------------
+
+
+def _templates_used(monkeypatch: pytest.MonkeyPatch) -> list[str]:
+    from breeze_infer import synthesis
+
+    used: list[str] = []
+    real = synthesis.get_template
+
+    def recording(name: str) -> Any:
+        used.append(name)
+        return real(name)
+
+    monkeypatch.setattr(synthesis, "get_template", recording)
+    return used
+
+
+def test_prepare_piece_without_instruction_uses_upstreams_plain_templates(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    used = _templates_used(monkeypatch)
+    codes = torch.zeros((7, 16), dtype=torch.int16)
+    model = model_with_codec_facts()
+
+    plain = prepare_piece(FakeTokenizer(), model, NoRef(), "hello", None, 1.0)
+    clone = prepare_piece(
+        FakeTokenizer(), model, CodesRef(codes=codes, ref_text="the ref"), "hello", None, 1.0
+    )
+    prepare_piece(FakeTokenizer(), model, NoRef(), "hello", "calm voice", 1.0)
+    prepare_piece(
+        FakeTokenizer(), model, CodesRef(codes=codes, ref_text="the ref"), "hello", "calm", 1.0
+    )
+
+    assert used == ["tts_plain", "ref_clone_tata", "tts_instruction", "ref_edit_tata"]
+    assert plain.get("input_values") is None
+    assert clone["input_values"] is not None
+    assert "cfg_negative_prompt_ids" not in plain and "cfg_negative_prompt_ids" not in clone
+
+
+def test_room_and_anchor_sizing_work_without_an_instruction() -> None:
+    runtime = FakeRuntime()
+    runtime.model = model_with_codec_facts()
+    codes = torch.zeros((7, 16), dtype=torch.int16)
+    for reference in (NoRef(), CodesRef(codes=codes, ref_text="a reference transcript")):
+        real = prepare_piece(FakeTokenizer(), runtime.model, reference, "Hello there.", None, 1.0)
+        predicted = predicted_room(
+            runtime, FakeTokenizer(), reference, "Hello there.", None, 1.0, None
+        )
+        assert predicted == piece_room(runtime, real, None)
+
+    sizing = anchor_sizing(runtime, FakeTokenizer(), ANCHOR_TEXT, LATER_TEXTS, None, 1.0)
+    for frames in (1, 7):
+        anchor = CodesRef(codes=torch.zeros((frames, 16), dtype=torch.int16), ref_text=ANCHOR_TEXT)
+        for text, length in zip(LATER_TEXTS, sizing.later_lengths, strict=True):
+            assert sizing.anchored(length, frames) == prompt_length(
+                prepare_piece(FakeTokenizer(), runtime.model, anchor, text, None, 1.0)
+            )
